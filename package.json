{
  "name": "codex-pulse",
  "productName": "Quota management",
  "version": "0.5.0",
  "description": "A private desktop home for all your Codex accounts, powered by ccswap.",
  "author": "Codex Pulse contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/create-icon.cjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "package:dir": "npm run build && electron-builder --win --dir --x64 --publish never"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "build": {
    "appId": "com.codexpulse.desktop",
    "productName": "Quota management",
    "executableName": "Codex Pulse",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json", "LICENSE", "THIRD_PARTY_NOTICES.md"],
    "extraResources": [{ "from": "engine-dist", "to": "engine", "filter": ["**/*"] }],
    "win": { "target": ["nsis", "portable"], "icon": "public/pulse.ico", "signExecutable": false },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Quota management", "deleteAppDataOnUninstall": false, "artifactName": "Quota-Management-Setup-${version}-${arch}.${ext}" },
    "portable": { "artifactName": "Quota-Management-Portable-${version}-${arch}.${ext}" },
    "artifactName": "Quota-Management-${version}-${arch}.${ext}"
  }
}

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_background">
    <FrameLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="24dp">
        <TextView android:id="@+id/widget_period" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingEnd="30dp" android:layout_gravity="center_vertical" android:text="@string/widget_remaining" android:textSize="12sp" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_muted" />
        <ImageView android:id="@+id/widget_refresh" android:layout_width="28dp" android:layout_height="24dp" android:layout_gravity="end|center_vertical" android:padding="4dp" android:src="@drawable/ic_widget_refresh" android:contentDescription="@string/refresh_usage" />
    </FrameLayout>
    <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="18dp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:text="@string/pair_pc" android:textSize="11sp" android:textColor="@color/widget_muted" />
</LinearLayout>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_period" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/weekly_remaining" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_muted" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="44dp" android:gravity="center" android:text="@string/refresh_icon" android:textSize="23sp" android:textColor="@color/widget_accent" android:contentDescription="@string/refresh_usage" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="18dp" android:maxLines="1" android:ellipsize="end" android:text="@string/pair_pc" android:textSize="11sp" android:textColor="@color/widget_muted" />
</LinearLayout>

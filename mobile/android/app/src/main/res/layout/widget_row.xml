<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:orientation="vertical" android:paddingBottom="4dp" android:layout_marginBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/row_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="middle" android:includeFontPadding="false" android:textSize="14sp" android:textColor="@color/widget_text" />
        <TextView android:id="@+id/row_percent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:includeFontPadding="false" android:textSize="26sp" android:fontFamily="sans-serif-light" android:textColor="@color/widget_accent" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="4dp">
        <ProgressBar android:id="@+id/row_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:minHeight="0dp" android:maxHeight="4dp" android:padding="0dp" android:progressDrawable="@drawable/quota_progress" android:progressTint="@null" android:progressBackgroundTint="@null" android:indeterminate="false" android:max="100" android:importantForAccessibility="no" />
        <ProgressBar android:id="@+id/row_progress_selected" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:minHeight="0dp" android:maxHeight="4dp" android:padding="0dp" android:progressDrawable="@drawable/quota_progress" android:progressTint="@null" android:progressBackgroundTint="@null" android:indeterminate="false" android:max="100" android:visibility="gone" android:importantForAccessibility="no" />
    </FrameLayout>
    <TextView android:id="@+id/row_reset" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:textSize="11sp" android:textColor="@color/widget_muted" />
</LinearLayout>
